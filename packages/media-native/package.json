{
  "name": "@headless-media/native",
  "version": "0.1.0",
  "description": "React Native wrapper for @headless-media/core — same contract as @headless-media/react",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@headless-media/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@headless-media/eslint-config": "workspace:*",
    "@headless-media/typescript-config": "workspace:*",
    "@types/react": "^18.3.18",
    "eslint": "^8.57.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "keywords": ["media", "sdk", "pexels", "react-native", "hooks", "provider"]
}
