{
  "name": "@headless-media/ui-native",
  "version": "0.1.0",
  "description": "Headless UI components for React Native — same contract as @headless-media/ui-react",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@headless-media/eslint-config": "workspace:*",
    "@headless-media/typescript-config": "workspace:*",
    "@types/react": "^18.3.18",
    "eslint": "^8.57.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "keywords": ["headless", "ui", "react-native", "grid", "lightbox", "reel"]
}
