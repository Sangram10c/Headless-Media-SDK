{
  "name": "@headless-media/web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"const fs = require('fs'); fs.cpSync('dist', '../../dist', {recursive: true});\"",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "dependencies": {
    "@headless-media/core": "workspace:*",
    "@headless-media/react": "workspace:*",
    "@headless-media/ui-react": "workspace:*",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@headless-media/eslint-config": "workspace:*",
    "@headless-media/typescript-config": "workspace:*",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
